#!/usr/bin/env python3
"""Refuse start unless HTTP_PORT / MYSQL_PORT are set in .env and free."""

from __future__ import annotations

import os
import re
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
OURS = {
    "dns-scan-nginx",
    "dns-scan-php",
    "dns-scan-worker",
    "dns-scan-mariadb",
    "dns-scan-mysql",  # legacy name, treat as ours
}

PORT_RE = re.compile(
    r"(?:0\.0\.0\.0|127\.0\.0\.1|\[::\]):(\d+)(?:-(\d+))?->"
)


def load_env(path: Path) -> dict[str, str]:
    values: dict[str, str] = {}
    if not path.is_file():
        return values
    for raw in path.read_text().splitlines():
        line = raw.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        values[key.strip()] = value.strip().strip('"').strip("'")
    return values


def docker_port_owners() -> dict[int, list[tuple[str, str]]]:
    out = subprocess.check_output(
        [
            "docker",
            "ps",
            "-a",
            "--format",
            "{{.Names}}\t{{.Status}}\t{{.Ports}}",
        ],
        text=True,
    )
    owners: dict[int, list[tuple[str, str]]] = {}
    for line in out.splitlines():
        parts = line.split("\t")
        if len(parts) < 3:
            continue
        name, status, ports = parts[0], parts[1], parts[2]
        state = status.split()[0] if status else "?"
        for match in PORT_RE.finditer(ports):
            start = int(match.group(1))
            end = int(match.group(2) or match.group(1))
            for port in range(start, end + 1):
                owners.setdefault(port, []).append((name, state))
    return owners


def env_port(name: str, env: dict[str, str]) -> str:
    return (os.environ.get(name) or env.get(name) or "").strip()


def parse_port(name: str, raw: str, errors: list[str]) -> int | None:
    if raw == "":
        errors.append(f"{name} is empty. Set it in .env (no default).")
        return None
    try:
        port = int(raw)
    except ValueError:
        errors.append(f"{name}={raw!r} is not an integer.")
        return None
    if port < 1 or port > 65535:
        errors.append(f"{name}={port} is out of range 1-65535.")
        return None
    return port


def suggest_free_ports(owners: dict[int, list[tuple[str, str]]], skip: set[int]) -> None:
    print("\nRefusing to start. Set free ports in .env, for example:", file=sys.stderr)
    busy = set(owners) | skip
    for p in range(8800, 9000):
        if p not in busy:
            print(f"  HTTP_PORT={p}", file=sys.stderr)
            break
    for p in range(3307, 3400):
        if p not in busy:
            print(f"  MYSQL_PORT={p}", file=sys.stderr)
            break


def host_listeners(port: int) -> list[str]:
    try:
        out = subprocess.check_output(
            ["lsof", "-nP", f"-iTCP:{port}", "-sTCP:LISTEN"],
            text=True,
            stderr=subprocess.DEVNULL,
        )
    except subprocess.CalledProcessError:
        return []
    rows = []
    for line in out.splitlines()[1:]:
        cols = line.split()
        if len(cols) >= 1:
            rows.append(cols[0])
    return sorted(set(rows))


def main() -> int:
    env = load_env(ROOT / ".env")
    errors: list[str] = []
    http_port = parse_port("HTTP_PORT", env_port("HTTP_PORT", env), errors)
    db_port = parse_port("MYSQL_PORT", env_port("MYSQL_PORT", env), errors)
    if http_port is not None and db_port is not None and http_port == db_port:
        errors.append(f"HTTP_PORT and MYSQL_PORT cannot both be {http_port}.")

    owners = docker_port_owners()

    print("Port check for dns-scan:")
    if http_port is None or db_port is None:
        print("  HTTP_PORT / MYSQL_PORT must be set in .env before start.")
        suggest_free_ports(owners, {p for p in (http_port, db_port) if p is not None})
        for msg in errors:
            print(f"ERROR: {msg}", file=sys.stderr)
        return 1

    for label, port in (("HTTP_PORT", http_port), ("MYSQL_PORT", db_port)):
        docker_hits = owners.get(port, [])
        foreign = [(n, s) for n, s in docker_hits if n not in OURS]
        our = [(n, s) for n, s in docker_hits if n in OURS]
        listeners = host_listeners(port)

        print(f"  {label}={port}")
        if our:
            print(f"    ours: {', '.join(f'{n} ({s})' for n, s in our)}")
        if foreign:
            detail = ", ".join(f"{n} ({s})" for n, s in foreign)
            errors.append(f"{label}={port} taken by other Docker container(s): {detail}")
            print(f"    CONFLICT docker: {detail}")
        elif not our and listeners:
            # Port held outside docker (or docker-proxy without matching container map)
            non_docker = [c for c in listeners if c not in {"com.docke", "com.docker"}]
            if non_docker:
                detail = ", ".join(non_docker)
                errors.append(f"{label}={port} taken on host by: {detail}")
                print(f"    CONFLICT host: {detail}")
            else:
                print("    free for dns-scan (no foreign owners)")
        else:
            print("    free for dns-scan")

    if errors:
        suggest_free_ports(owners, {http_port, db_port})
        for msg in errors:
            print(f"ERROR: {msg}", file=sys.stderr)
        return 1

    print("OK: ports do not conflict with other containers.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
