#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
APP_DIR="$ROOT/app"

if [[ -f "$APP_DIR/composer.json" ]]; then
  echo "Yii3 app already exists in app/"
  exit 0
fi

if [[ ! -f "$ROOT/.env" ]]; then
  cp "$ROOT/.env.example" "$ROOT/.env"
fi

echo "Creating Yii3 app in app/ ..."
mkdir -p "$APP_DIR"

docker run --rm \
  -u "$(id -u):$(id -g)" \
  -v "$ROOT:/work" \
  -w /work \
  composer:2 \
  composer create-project yiisoft/app app --no-interaction --prefer-dist

cat > "$APP_DIR/.env.local" <<'EOF'
# Generated by dns-scan bootstrap. DB host is the mysql service name.
DB_DSN=mysql:host=mysql;port=3306;dbname=dns_scan
DB_USER=dns_scan
DB_PASSWORD=dns_scan
EOF

echo
echo "Done."
echo "Next:"
echo "  cd $ROOT"
echo "  make up"
echo "  open http://localhost:$(grep '^HTTP_PORT=' "$ROOT/.env" 2>/dev/null | cut -d= -f2 || echo 8898)"
