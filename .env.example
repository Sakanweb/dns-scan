# Ports (required, no defaults). Pick free host ports, then `make check-ports`.
HTTP_PORT=
MYSQL_PORT=

# MariaDB
MYSQL_DATABASE=dns_scan
MYSQL_USER=dns_scan
MYSQL_PASSWORD=dns_scan
MYSQL_ROOT_PASSWORD=root

# App DB (inside docker network; PDO driver stays "mysql")
YII_DB_DSN=mysql:host=mariadb;port=3306;dbname=dns_scan
YII_DB_USER=dns_scan
YII_DB_PASSWORD=dns_scan

# Scan limits
DNS_THREADS=40
HTTP_TIMEOUT=10
DNS_TIMEOUT=3
DNS_RESOLVER=1.1.1.1

# App
APP_ENV=dev
APP_DEBUG=true
